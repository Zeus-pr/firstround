# Firebase (public) — web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=firstround-space.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=firstround-space
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=firstround-space.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public API origin used by the browser (web)
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# API service
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
WEB_ORIGIN=http://localhost:3000
PORT=4000

# Local/dev envelope KEK only (32 raw bytes, base64). Never use for production Gmail tokens.
LOCAL_KEK_BASE64=
LOCAL_KEK_VERSION=1
