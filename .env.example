# Firebase (public) — web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=firstround-space.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=firstround-space
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=firstround-space.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public API origin used by the browser (web)
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# API service
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
WEB_ORIGIN=http://localhost:3000
PORT=4000

# Local/dev envelope KEK only (32 raw bytes, base64). Never use for production Gmail tokens.
LOCAL_KEK_BASE64=
LOCAL_KEK_VERSION=1

# Cloudflare R2 (S3 API) — bucket firstround-cv
R2_ACCOUNT_ID=e1e2ce8ab37dba30e2fed136e733d405
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=firstround-cv
# Optional override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
