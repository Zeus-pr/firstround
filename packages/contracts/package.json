{
  "name": "@firstround/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "sh ../../scripts/vitest.sh run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@firstround/config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
