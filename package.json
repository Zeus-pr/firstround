{
  "name": "firstround",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:ci": "tsx db/ci-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run db:ci && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/google-sans": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@yogesharc/thinking-orbs": "^0.1.2",
    "drizzle-orm": "^0.45.4",
    "firebase": "^13.2.0",
    "gsap": "^3.13.0",
    "next": "^15.5.4",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 100
  }
