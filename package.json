{
  "name": "firstround",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@firstround/web --filter=@firstround/api",
    "dev:api": "turbo run dev --filter=@firstround/api",
    "dev:web": "turbo run dev --filter=@firstround/web",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@firstround/api...",
    "build:web": "turbo run build --filter=@firstround/web...",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @firstround/db db:migrate",
    "db:seed": "pnpm --filter @firstround/db db:seed",
    "db:ci": "pnpm --filter @firstround/db db:ci",
    "db:generate": "pnpm --filter @firstround/db db:generate",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run db:ci && pnpm run build",
    "start:api": "node apps/api/dist/main.js",
    "start:web": "pnpm --filter @firstround/web start"
  },
  "devDependencies": {
    "@firstround/config": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "turbo": "^2.5.8",
    "typescript": "~5.9.3"
  },
  "prettier": "@firstround/config/prettier"
}
