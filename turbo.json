{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "WEB_ORIGIN", "LOCAL_KEK_BASE64", "LOCAL_KEK_VERSION"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "LOCAL_KEK_BASE64", "LOCAL_KEK_VERSION", "WEB_ORIGIN"]
    }
  },
  "globalPassThroughEnv": [
    "TMPDIR",
    "NODE_COMPILE_CACHE",
    "XDG_CACHE_HOME",
    "XDG_DATA_HOME",
    "XDG_STATE_HOME",
    "npm_config_cache",
    "COREPACK_HOME",
    "TURBO_TELEMETRY_DISABLED",
    "NEXT_TELEMETRY_DISABLED"
  ]
}
